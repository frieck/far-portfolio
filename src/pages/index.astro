---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSystem from "../components/HeroSystem";
import { getCollection, getEntry, render } from "astro:content";

const profileEntry = await getEntry("profile", "home");
const competenciesEntry = await getEntry("competencies", "core");
const experience = (await getCollection("experience")).sort(
  (a, b) =>
    Number(b.data.current) - Number(a.data.current) ||
    b.data.startDate.getTime() - a.data.startDate.getTime(),
);
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const projectIcons: Record<string, string> = {
  prowl: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6 4 2M18 6l2-4"/><path d="M12 3.2c-4 0-7 3.4-7 8 0 4.6 2.8 8.3 7 9.8 4.2-1.5 7-5.2 7-9.8 0-4.6-3-8-7-8Z"/><circle cx="9" cy="11" r="2.2"/><circle cx="15" cy="11" r="2.2"/><circle cx="9" cy="11" r="0.6" fill="currentColor" stroke="none"/><circle cx="15" cy="11" r="0.6" fill="currentColor" stroke="none"/><path d="m12 13.4-1.1 1.6h2.2L12 13.4Z" fill="currentColor" stroke="none"/></svg>`,
  invoxa: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5h9l3 3v16l-2-1.3-2 1.3-2-1.3-2 1.3-2-1.3-2 1.3V2.5Z"/><path d="M8.5 8h7M8.5 11.5h7M8.5 15h4.5"/></svg>`,
};
const cases = (await getCollection("cases")).sort(
  (a, b) => a.data.order - b.data.order,
);
const education = (await getCollection("education")).sort(
  (a, b) => a.data.order - b.data.order,
);

if (!profileEntry || !competenciesEntry) {
  throw new Error(
    "Missing content in src/content/profile/home.md or src/content/competencies/core.md",
  );
}

const profile = profileEntry.data;
const competencies = competenciesEntry.data;
const { Content: ProfileContent } = await render(profileEntry);
const emailCodes = profile.email
  .split("")
  .map((char) => char.charCodeAt(0) + 11)
  .join(",");
---

<BaseLayout
  title="Felipe Augusto Rieck | FAR"
  description="Felipe Augusto Rieck portfolio — Staff/Principal Full-Stack Engineer."
>
  <nav class="section-nav" aria-label="Sections">
    <a href="#selected-work">Selected Work</a>
    <a href="#experience">Experience</a>
    <a href="#projects">Projects</a>
  </nav>

  <section class="hero card reveal">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">
          <span>{profile.yearsOfExperience}+ years</span>
          {profile.pillars.map((pillar) => <span>{pillar}</span>)}
        </p>
        <h1>{profile.name}</h1>
        <p class="hero-role">{profile.role}</p>
        <p class="lead">{profile.lead}</p>

        <div class="hero-actions">
          <a
            class="btn primary"
            href="#"
            data-contact-codes={emailCodes}
            aria-label="Contact by email">Contact</a
          >
          <a
            class="btn"
            href={profile.linkedin}
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn (opens in a new tab)">LinkedIn</a
          >
        </div>
      </div>
      <div class="hero-visual">
        <HeroSystem client:only="react" labels={profile.pillars} />
      </div>
    </div>
  </section>

  <section class="reveal">
    <h2 class="section-title">Summary</h2>
    <article class="card prose-invert">
      <ProfileContent />
    </article>
  </section>

  <section class="reveal" id="selected-work">
    <h2 class="section-title">Selected Work</h2>
    <div class="case-grid">
      {
        cases.map((item) => (
          <a class="card case-card tilt-card" href={`/cases/${item.id}/`}>
            <p class="case-meta">
              {[item.data.company, item.data.period]
                .filter(Boolean)
                .join(" · ")}
            </p>
            <h3 class="item-title">{item.data.title}</h3>
            <p class="case-summary">{item.data.summary}</p>
            {item.data.metric && (
              <div class="case-metric case-metric-stacked">
                <span class="case-metric-before">{item.data.metric.before}</span>
                <span class="case-metric-result">
                  <span class="case-metric-arrow" aria-hidden="true">→</span>
                  <span class="sr-only">to</span>
                  <span class="case-metric-after">{item.data.metric.after}</span>
                </span>
              </div>
            )}
            <span class="case-link">Read the case →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="reveal">
    <h2 class="section-title">{competencies.title}</h2>
    <article class="card competency-card tilt-card">
      <div class="chips">
        {competencies.items.map((item) => <span>{item}</span>)}
      </div>
      {
        competencies["aditional-technologies"] && (
          <div class="competency-secondary">
            <div class="section-divider">
              <span>Additional Technologies</span>
            </div>
            <div class="chips chips-secondary">
              {competencies["aditional-technologies"].map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>
        )
      }
    </article>
  </section>

  <section id="experience">
    <h2 class="section-title">Experience</h2>
    <div class="timeline">
      {
        experience.map((item) => (
          <article class="card timeline-item tilt-card reveal">
            <div class="timeline-dot" />
            <h3 class="item-title">{item.data.role}</h3>
            <p class="company">
              {item.data.company} · {item.data.period}
            </p>
            {item.data.location && <p class="location">{item.data.location}</p>}
            <ul>
              {item.data.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <p class="stack">{item.data.technologies.join(" • ")}</p>
            {item.data.caseStudy && (
              <a
                class="case-link timeline-case-link"
                href={`/cases/${item.data.caseStudy.id}/`}
                aria-label={`Read the ${item.data.company} case study`}
              >
                Read the case →
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="reveal" id="projects">
    <h2 class="section-title">Projects</h2>
    <div class="timeline">
      {
        projects.map((item) => (
          <article class="card timeline-item tilt-card">
            <div class="timeline-dot" />
            <h3 class="item-title">{item.data.name}</h3>
            <p class="company">{item.data.tagline}</p>
            <ul>
              {item.data.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <p class="stack">{item.data.stack.join(" • ")}</p>
            <div class="hero-actions project-actions">
              <a
                class="btn"
                href={item.data.repoUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`${item.data.name} on GitHub (opens in a new tab)`}
              >
                GitHub ↗
              </a>
              {item.data.status && (
                <span class="project-status">{item.data.status}</span>
              )}
            </div>
            <span
              class="project-icon"
              aria-hidden="true"
              set:html={projectIcons[item.data.name.toLowerCase()]}
            />
          </article>
        ))
      }
    </div>
  </section>

  <section class="reveal">
    <h2 class="section-title">Languages</h2>
    <article class="card chips tilt-card">
      <span>Portuguese (Native)</span>
      <span>English (Full Professional)</span>
      <span>German (Elementary)</span>
      <span>Spanish (Limited Working)</span>
    </article>
  </section>

  <section class="reveal">
    <h2 class="section-title">Education</h2>
    <div class="timeline">
      {
        education.map((item) => (
          <article class="card timeline-item tilt-card">
            <div class="timeline-dot" />
            <h3 class="item-title">{item.data.degree}</h3>
            <p class="company">
              {item.data.institution} · {item.data.period}
            </p>
            <p class="location">{item.data.location}</p>
          </article>
        ))
      }
    </div>
  </section>

  <script is:inline>
    // Page entrance
    document.querySelectorAll(".reveal").forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add("is-visible");
      }
    });
    document.body.classList.add("page-enter");
    window.setTimeout(() => {
      document.body.classList.remove("page-enter");
    }, 1600);

    // Reveal on scroll
    const reveals = document.querySelectorAll(".reveal");
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("is-visible");
        });
      },
      { threshold: 0.12 },
    );
    reveals.forEach((el) => io.observe(el));

    // Cursor glow
    const glow = document.getElementById("cursor-glow");
    window.addEventListener("mousemove", (e) => {
      if (glow) {
        glow.style.left = `${e.clientX}px`;
        glow.style.top = `${e.clientY}px`;
      }
    });

    // Contact link: the address ships obfuscated and becomes a mailto on load.
    const contactLink = document.querySelector("[data-contact-codes]");
    if (contactLink) {
      const encoded = contactLink.getAttribute("data-contact-codes") || "";
      const email = encoded
        .split(",")
        .map((code) => String.fromCharCode(Number(code) - 11))
        .join("");
      contactLink.setAttribute("href", `mailto:${email}`);
    }

    // Tilt cards
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const cards = reduceMotion ? [] : document.querySelectorAll(".tilt-card");
    cards.forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const r = card.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        const rx = (y / r.height - 0.5) * -8;
        const ry = (x / r.width - 0.5) * 10;
        card.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-2px)`;
      });
      card.addEventListener("mouseleave", () => {
        card.style.transform =
          "perspective(900px) rotateX(0deg) rotateY(0deg) translateY(0)";
      });
    });
  </script>
</BaseLayout>
