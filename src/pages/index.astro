---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";

const profileEntry = await getEntry("profile", "home");
const competenciesEntry = await getEntry("competencies", "core");
const experience = (await getCollection("experience")).sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const projectIcons: Record<string, string> = {
  prowl: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6 4 2M18 6l2-4"/><path d="M12 3.2c-4 0-7 3.4-7 8 0 4.6 2.8 8.3 7 9.8 4.2-1.5 7-5.2 7-9.8 0-4.6-3-8-7-8Z"/><circle cx="9" cy="11" r="2.2"/><circle cx="15" cy="11" r="2.2"/><circle cx="9" cy="11" r="0.6" fill="currentColor" stroke="none"/><circle cx="15" cy="11" r="0.6" fill="currentColor" stroke="none"/><path d="m12 13.4-1.1 1.6h2.2L12 13.4Z" fill="currentColor" stroke="none"/></svg>`,
  invoxa: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5h9l3 3v16l-2-1.3-2 1.3-2-1.3-2 1.3-2-1.3-2 1.3V2.5Z"/><path d="M8.5 8h7M8.5 11.5h7M8.5 15h4.5"/></svg>`,
};
const education = (await getCollection("education")).sort(
  (a, b) => a.data.order - b.data.order,
);

if (!profileEntry || !competenciesEntry) {
  throw new Error(
    "Missing content in src/content/profile/home.md or src/content/competencies/core.md",
  );
}

const profile = profileEntry.data;
const competencies = competenciesEntry.data;
const { Content: ProfileContent } = await render(profileEntry);
const BOOT_DURATION_MS = 3600;
const emailCodes = profile.email
  .split("")
  .map((char) => char.charCodeAt(0) + 11)
  .join(",");
---

<BaseLayout
  title="Felipe Augusto Rieck | FAR"
  description="Felipe Augusto Rieck portfolio — Staff/Principal Full-Stack Engineer."
>
  <div
    class="boot-terminal"
    data-boot-terminal
    data-boot-text={profile.bootMessage}
    data-boot-duration={BOOT_DURATION_MS}
    aria-hidden="true"
  >
    <div class="boot-window">
      <span class="boot-prompt">&gt;</span>
      <span data-boot-output></span>
      <span class="boot-cursor"></span>
    </div>
  </div>

  <section class="hero card reveal">
    <h1 class="glitch" data-text={profile.name}>{profile.name}</h1>
    <h2>{profile.role}</h2>
    <p class="lead">{profile.lead}</p>

    <div class="hero-actions">
      <a class="btn primary" href="#" data-contact-codes={emailCodes}>Contact</a>
      <a class="btn" href={profile.linkedin} target="_blank" rel="noreferrer"
        >LinkedIn</a
      >
    </div>
  </section>

  <section class="reveal">
    <h3>Summary</h3>
    <article class="card prose-invert">
      <ProfileContent />
    </article>
  </section>

  <section class="reveal">
    <h3>{competencies.title}</h3>
    <article class="card competency-card tilt-card">
      <div class="chips">
        {competencies.items.map((item) => <span>{item}</span>)}
      </div>
      {
        competencies["aditional-technologies"] && (
          <div class="competency-secondary">
            <div class="section-divider">
              <span>Additional Technologies</span>
            </div>
            <div class="chips chips-secondary">
              {competencies["aditional-technologies"].map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>
        )
      }
    </article>
  </section>

  <section>
    <h3>Experience</h3>
    <div class="timeline">
      {
        experience.map((item) => (
          <article class="card timeline-item tilt-card reveal">
            <div class="timeline-dot" />
            <h4>{item.data.role}</h4>
            <p class="company">
              {item.data.company} · {item.data.period}
            </p>
            {item.data.location && <p class="location">{item.data.location}</p>}
            <ul>
              {item.data.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <p class="stack">{item.data.technologies.join(" • ")}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="reveal">
    <h3>Projects</h3>
    <div class="timeline">
      {
        projects.map((item) => (
          <article class="card timeline-item tilt-card">
            <div class="timeline-dot" />
            <div class="project-header">
              <span
                class="project-icon"
                set:html={projectIcons[item.data.name.toLowerCase()]}
              />
              <h4>{item.data.name}</h4>
            </div>
            <p class="company">{item.data.tagline}</p>
            <ul>
              {item.data.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <p class="stack">{item.data.stack.join(" • ")}</p>
            <div class="hero-actions project-actions">
              <a
                class="btn"
                href={item.data.repoUrl}
                target="_blank"
                rel="noreferrer"
              >
                GitHub ↗
              </a>
              {item.data.status && (
                <span class="project-status">{item.data.status}</span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="reveal">
    <h3>Languages</h3>
    <article class="card chips tilt-card">
      <span>Portuguese (Native)</span>
      <span>English (Full Professional)</span>
      <span>German (Elementary)</span>
      <span>Spanish (Limited Working)</span>
    </article>
  </section>

  <section class="reveal">
    <h3>Education</h3>
    <div class="timeline">
      {
        education.map((item) => (
          <article class="card timeline-item tilt-card">
            <div class="timeline-dot" />
            <h4>{item.data.degree}</h4>
            <p class="company">
              {item.data.institution} · {item.data.period}
            </p>
            <p class="location">{item.data.location}</p>
          </article>
        ))
      }
    </div>
  </section>

  <script is:inline>
    // Boot terminal
    if ("scrollRestoration" in history) {
      history.scrollRestoration = "manual";
    }
    window.scrollTo({ top: 0, left: 0, behavior: "instant" });

    const boot = document.querySelector("[data-boot-terminal]");
    const bootOutput = document.querySelector("[data-boot-output]");
    const revealVisibleContent = () => {
      document.querySelectorAll(".reveal").forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          el.classList.add("is-visible");
        }
      });
    };

    if (boot && bootOutput) {
      const text = boot.dataset.bootText || "";
      const duration = Number(boot.dataset.bootDuration || 3600);
      const typeDuration = Math.max(900, Math.min(duration - 900, 1900));
      const startedAt = performance.now();

      const typeFrame = (now) => {
        const progress = Math.min((now - startedAt) / typeDuration, 1);
        const length = Math.floor(progress * text.length);
        bootOutput.textContent = text.slice(0, length);

        if (progress < 1) {
          requestAnimationFrame(typeFrame);
        }
      };

      requestAnimationFrame(typeFrame);

      window.setTimeout(() => {
        bootOutput.textContent = text;
        window.scrollTo({ top: 0, left: 0, behavior: "instant" });
        document.body.classList.remove("is-booting");
        document.body.classList.add("boot-complete");
        revealVisibleContent();
        window.setTimeout(() => {
          document.body.classList.remove("boot-complete");
        }, 1600);
      }, duration);
    } else {
      window.scrollTo({ top: 0, left: 0, behavior: "instant" });
      document.body.classList.remove("is-booting");
      document.body.classList.add("boot-complete");
      revealVisibleContent();
      window.setTimeout(() => {
        document.body.classList.remove("boot-complete");
      }, 1600);
    }

    // Reveal on scroll
    const reveals = document.querySelectorAll(".reveal");
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("is-visible");
        });
      },
      { threshold: 0.12 },
    );
    reveals.forEach((el) => io.observe(el));

    // Cursor glow
    const glow = document.getElementById("cursor-glow");
    window.addEventListener("mousemove", (e) => {
      if (glow) {
        glow.style.left = `${e.clientX}px`;
        glow.style.top = `${e.clientY}px`;
      }
    });

    // Contact link
    const contactLink = document.querySelector("[data-contact-codes]");
    contactLink?.addEventListener("click", (e) => {
      e.preventDefault();
      const encoded = contactLink.getAttribute("data-contact-codes") || "";
      const email = encoded
        .split(",")
        .map((code) => String.fromCharCode(Number(code) - 11))
        .join("");

      window.location.href = `mailto:${email}`;
    });

    // Tilt cards
    const cards = document.querySelectorAll(".tilt-card");
    cards.forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const r = card.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        const rx = (y / r.height - 0.5) * -8;
        const ry = (x / r.width - 0.5) * 10;
        card.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-2px)`;
      });
      card.addEventListener("mouseleave", () => {
        card.style.transform =
          "perspective(900px) rotateX(0deg) rotateY(0deg) translateY(0)";
      });
    });
  </script>
</BaseLayout>
