---
import "../styles/global.css";
import SciFiBackground from "../components/SciFiBackground";
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=blueprint" />
    <link rel="alternate icon" href="/favicon.ico?v=blueprint" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <SciFiBackground client:load />
    <div class="grid-bg"></div>
    <div id="cursor-glow" aria-hidden="true"></div>

    <main class="container">
      <slot />
    </main>
  </body>
</html>
